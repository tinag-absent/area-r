# Turso Database
# turso db create kaishoku && turso db show kaishoku
TURSO_DATABASE_URL=libsql://your-db-name.turso.io

# turso db tokens create kaishoku
TURSO_AUTH_TOKEN=eyJ...

# JWT署名シークレット（本番では必ず変更: openssl rand -base64 32）
JWT_SECRET=change-me-in-production-use-openssl-rand-base64-32

# 内部APIルート間の認証シークレット（32文字以上必須）
# openssl rand -base64 32
INTERNAL_SECRET=change-me-in-production-must-be-32-chars-minimum

# ベースURL（本番はVercelのURL）
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── EmailJS（パスワードリセット OTP メール送信用）─────────────────────
# https://www.emailjs.com/ でアカウント作成後に取得
# テンプレート変数: to_email / otp_code / agent_id / org_name
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_xxxxxxx
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxx

# Web Push (VAPID) — https://www.npmjs.com/package/web-push で生成
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# EmailJS — 登録認証メール用テンプレート
# パスワードリセットと別テンプレートを使う場合のみ設定（なければリセット用テンプレートを流用）
NEXT_PUBLIC_EMAILJS_REGISTER_TEMPLATE_ID=""
